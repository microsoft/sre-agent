    "exportedBy": "Azure SRE Agent Live Report example"
  },
  "spec": {
    "allowedTools": [
      "system-mcp-monitor_monitor_workspace_log_query"
    ],
    "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <meta http-equiv=\"Content-Security-Policy\" content=\"\n    default-src 'none';\n    script-src 'self' 'nonce-{REPORT_NONCE}' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://esm.sh;\n    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;\n    font-src 'self' data: https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com;\n    img-src 'self' data: blob: https:;\n    connect-src 'self';\n  \">\n  <title>Third-Party Software Update Tracker</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n  <script src=\"https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js\" integrity=\"sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js\" integrity=\"sha384-y49Zu59jZHJL/PLKgZPv3k2WI9c0Yp3pWB76V8OBVCb0QBKS8l4Ff3YslzHVX76Y\" crossorigin=\"anonymous\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/gridjs@6.2.0/dist/gridjs.umd.js\" integrity=\"sha384-y62I+ZvjNRolkugL/AMpUZykqrL6oqYxBruObmlDAhDpmapM0s+xgvVK+wGVpza0\" crossorigin=\"anonymous\"></script>\n  <link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/gridjs@6.2.0/dist/theme/mermaid.min.css\" integrity=\"sha384-i8iPOOXHyYKlqvjJjbORq7m/VrfUhgupTg3IZvtXz8M7c0CiTPUUhM5gdjiQiGbv\" crossorigin=\"anonymous\">\n  <style nonce=\"{REPORT_NONCE}\">\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n    body {\n      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;\n      background: #f8fafc; color: #1e293b; line-height: 1.5;\n      padding: 24px; max-width: 1400px; margin: 0 auto;\n    }\n    .header { margin-bottom: 24px; }\n    .header h1 { font-size: 22px; font-weight: 700; color: #0f172a; margin-bottom: 4px; }\n    .header .subtitle { font-size: 13px; color: #64748b; }\n    .header .subtitle span { margin-right: 16px; }\n    .loading-overlay {\n      position: fixed; inset: 0; background: rgba(248,250,252,0.92);\n      display: flex; align-items: center; justify-content: center;\n      z-index: 1000; flex-direction: column; gap: 12px;\n    }\n    .loading-overlay .spinner {\n      width: 36px; height: 36px; border: 3px solid #e2e8f0;\n      border-top-color: #3b82f6; border-radius: 50%;\n      animation: spin 0.8s linear infinite;\n    }\n    @keyframes spin { to { transform: rotate(360deg); } }\n    .loading-overlay .text { font-size: 14px; color: #64748b; font-weight: 500; }\n\n    /* Summary Cards */\n    .summary-row {\n      display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n      gap: 14px; margin-bottom: 24px;\n    }\n    .card {\n      background: #fff; border-radius: 10px; padding: 18px 20px;\n      border: 1px solid #e2e8f0; position: relative; overflow: hidden;\n    }\n    .card .label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; margin-bottom: 6px; }\n    .card .value { font-size: 28px; font-weight: 700; }\n    .card .detail { font-size: 12px; color: #94a3b8; margin-top: 4px; }\n    .card.critical { border-left: 4px solid #dc2626; }\n    .card.critical .value { color: #dc2626; }\n    .card.warning { border-left: 4px solid #f59e0b; }\n    .card.warning .value { color: #f59e0b; }\n    .card.success { border-left: 4px solid #10b981; }\n    .card.success .value { color: #10b981; }\n    .card.info { border-left: 4px solid #3b82f6; }\n    .card.info .value { color: #3b82f6; }\n\n    /* Sections */\n    .section {\n      background: #fff; border-radius: 10px; border: 1px solid #e2e8f0;\n      margin-bottom: 20px; overflow: hidden;\n    }\n    .section-header {\n      padding: 16px 20px; border-bottom: 1px solid #f1f5f9;\n      display: flex; align-items: center; justify-content: space-between;\n      cursor: pointer; user-select: none;\n    }\n    .section-header:hover { background: #f8fafc; }\n    .section-header h2 { font-size: 15px; font-weight: 600; color: #0f172a; }\n    .section-header .badge {\n      font-size: 11px; font-weight: 600; padding: 3px 10px;\n      border-radius: 12px; color: #fff;\n    }\n    .badge-critical { background: #dc2626; }\n    .badge-warning { background: #f59e0b; }\n    .badge-info { background: #3b82f6; }\n    .badge-success { background: #10b981; }\n    .section-body { padding: 0; }\n    .section-body.collapsed { display: none; }\n\n    /* Priority Table */\n    .priority-table { width: 100%; border-collapse: collapse; font-size: 13px; }\n    .priority-table th {\n      text-align: left; padding: 10px 16px; background: #f8fafc;\n      font-weight: 600; color: #475569; font-size: 11px;\n      text-transform: uppercase; letter-spacing: 0.5px;\n      border-bottom: 1px solid #e2e8f0;\n    }\n    .priority-table td {\n      padding: 10px 16px; border-bottom: 1px solid #f1f5f9;\n      vertical-align: top;\n    }\n    .priority-table tr:last-child td { border-bottom: none; }\n    .priority-table tr:hover { background: #f8fafc; }\n    .risk-badge {\n      display: inline-block; font-size: 10px; font-weight: 700;\n      padding: 2px 8px; border-radius: 4px; text-transform: uppercase;\n      letter-spacing: 0.5px;\n    }\n    .risk-critical { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }\n    .risk-high { background: #fff7ed; color: #ea580c; border: 1px solid #fed7aa; }\n    .risk-medium { background: #fffbeb; color: #d97706; border: 1px solid #fde68a; }\n    .risk-low { background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; }\n    .risk-current { background: #f0fdf4; color: #16a34a; border: 1px solid #bbf7d0; }\n    .risk-unknown { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; }\n\n    .machine-list {\n      display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px;\n    }\n    .machine-tag {\n      font-size: 11px; background: #f1f5f9; color: #475569;\n      padding: 1px 6px; border-radius: 3px; font-family: 'Inter', monospace;\n    }\n\n    /* Chart container */\n    .chart-container { padding: 20px; max-height: 500px; }\n    canvas { max-height: 460px; }\n\n    /* Grid.js overrides */\n    .gridjs-wrapper { border: none !important; border-radius: 0 !important; }\n    .gridjs-table { font-size: 13px !important; }\n    .gridjs-th { font-size: 11px !important; text-transform: uppercase !important; letter-spacing: 0.5px !important; }\n    .gridjs-footer { border-top: 1px solid #f1f5f9 !important; }\n    .gridjs-search { padding: 12px 16px !important; }\n    .gridjs-search-input { font-family: 'Inter', sans-serif !important; font-size: 13px !important; }\n\n    /* Version DB info */\n    .vdb-info {\n      padding: 16px 20px; font-size: 12px; color: #64748b;\n      background: #f8fafc; border-top: 1px solid #f1f5f9;\n    }\n    .vdb-info strong { color: #475569; }\n    .vdb-grid {\n      display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n      gap: 10px; margin-top: 10px;\n    }\n    .vdb-item {\n      background: #fff; border: 1px solid #e2e8f0; border-radius: 6px;\n      padding: 10px 14px; font-size: 12px;\n    }\n    .vdb-item .prod { font-weight: 600; color: #1e293b; }\n    .vdb-item .ver { color: #10b981; font-weight: 500; }\n    .vdb-item .date { color: #94a3b8; }\n\n    .error-box {\n      padding: 20px; text-align: center; color: #dc2626;\n      font-size: 13px; background: #fef2f2; border-radius: 8px;\n      margin: 16px;\n    }\n    .empty-state {\n      padding: 32px; text-align: center; color: #94a3b8; font-size: 13px;\n    }\n    .banner {\n      padding: 10px 14px; border-radius: 8px; font-size: 12px; margin-bottom: 10px;\n      border: 1px solid #fde68a; background: #fffbeb; color: #92400e;\n    }\n    .banner.info { border-color: #bfdbfe; background: #eff6ff; color: #1e40af; }\n    #banners { margin-bottom: 14px; }\n\n    .toggle-arrow { transition: transform 0.2s; font-size: 12px; color: #94a3b8; }\n    .toggle-arrow.collapsed { transform: rotate(-90deg); }\n\n    .footer {\n      margin-top: 24px; padding: 16px 0; border-top: 1px solid #e2e8f0;\n      font-size: 11px; color: #94a3b8; text-align: center;\n    }\n  </style>\n</head>\n<body>\n\n<div class=\"loading-overlay\" id=\"loading\">\n  <div class=\"spinner\"></div>\n  <div class=\"text\">Querying software inventory across fleet...</div>\n</div>\n\n<div class=\"header\">\n  <h1>Third-Party Software Update Tracker</h1>\n  <div class=\"subtitle\">\n    <span id=\"refreshTs\">Loading...</span>\n    <span>Source: Log Analytics / ConfigurationData (Windows applications, non-Microsoft publishers)</span>\n    <span id=\"vdbTs\"></span>\n    <span id=\"coverageTs\"></span>\n    <span id=\"dataSource\"></span>\n  </div>\n</div>\n\n<div id=\"banners\"></div>\n\n<div class=\"summary-row\" id=\"summaryCards\">\n  <div class=\"card info\"><div class=\"label\">Total Products</div><div class=\"value\" id=\"totalCount\">--</div><div class=\"detail\">across fleet</div></div>\n  <div class=\"card success\"><div class=\"label\">Up to Date</div><div class=\"value\" id=\"currentCount\">--</div><div class=\"detail\">tracked products current</div></div>\n  <div class=\"card warning\"><div class=\"label\">Updates Available</div><div class=\"value\" id=\"outdatedCount\">--</div><div class=\"detail\">behind latest version</div></div>\n  <div class=\"card critical\"><div class=\"label\">Critical / High</div><div class=\"value\" id=\"criticalCount\">--</div><div class=\"detail\">security-relevant updates</div></div>\n  <div class=\"card\"><div class=\"label\">Untracked</div><div class=\"value\" id=\"untrackedCount\">--</div><div class=\"detail\">no reference version</div></div>\n</div>\n\n<div class=\"section\" id=\"prioritySection\">\n  <div class=\"section-header\" data-target=\"priorityBody\">\n    <h2>Priority Updates Required</h2>\n    <div><span class=\"badge badge-critical\" id=\"priorityBadge\">--</span> <span class=\"toggle-arrow\">&#9660;</span></div>\n  </div>\n  <div class=\"section-body\" id=\"priorityBody\">\n    <div id=\"priorityContent\"><div class=\"empty-state\">Loading...</div></div>\n  </div>\n</div>\n\n<div class=\"section\" id=\"inventorySection\">\n  <div class=\"section-header\" data-target=\"inventoryBody\">\n    <h2>Full Software Inventory</h2>\n    <div><span class=\"badge badge-info\" id=\"inventoryBadge\">--</span> <span class=\"toggle-arrow\">&#9660;</span></div>\n  </div>\n  <div class=\"section-body\" id=\"inventoryBody\">\n    <div id=\"inventoryGrid\"><div class=\"empty-state\">Loading...</div></div>\n  </div>\n</div>\n\n<div class=\"section\" id=\"machineSection\">\n  <div class=\"section-header\" data-target=\"machineBody\">\n    <h2>Outdated Software by Machine</h2>\n    <div><span class=\"toggle-arrow\">&#9660;</span></div>\n  </div>\n  <div class=\"section-body\" id=\"machineBody\">\n    <div class=\"chart-container\"><canvas id=\"machineChart\"></canvas></div>\n  </div>\n</div>\n\n<div class=\"section\" id=\"vdbSection\">\n  <div class=\"section-header\" data-target=\"vdbBody\">\n    <h2>Version Reference Database</h2>\n    <div><span class=\"toggle-arrow\">&#9660;</span></div>\n  </div>\n  <div class=\"section-body\" id=\"vdbBody\">\n    <div id=\"vdbContent\"></div>\n  </div>\n</div>\n\n<div class=\"footer\" id=\"footer\">\n  Data sourced from Azure Arc Change Tracking (ConfigurationData table, latest inventory snapshot per machine, Windows applications only). Version comparisons are numeric against an embedded, vendor-verified reference database (point-in-time snapshot; a banner appears if it is stale).\n</div>\n\n<script nonce=\"{REPORT_NONCE}\">\n/* ============================================================\n   DEPLOYMENT CONFIG - edit these values for your environment.\n   {REPORT_NONCE} must stay as-is: the Live Reports runtime replaces it.\n   ============================================================ */\nconst CONFIG = {\n  subscription: '__SUBSCRIPTION_ID__',\n  resourceGroup: '__RESOURCE_GROUP__',\n  workspaceId: '__WORKSPACE__',\n  lookbackHours: 168,\n  queryLimit: 1000\n};\nconst LOG_QUERY_TOOL = 'system-mcp-monitor_monitor_workspace_log_query';\n\n/* ============================================================\n   VERSION REFERENCE DATABASE\n   Point-in-time snapshot of latest known versions (vendor-verified).\n   Updated: 2026-10-15\n   All comparisons are numeric (installed >= latest = Current).\n   ============================================================ */\nconst VERSION_DB_DATE = '2026-10-15';\nconst VERSION_DB_MAX_AGE_DAYS = 30;\nconst PY_LATEST = { '3.14': '3.14.8', '3.13': '3.13.16', '3.12': '3.12.15', '3.11': '3.11.17' };\nconst NODE_LATEST = { '26': '26.12.0', '24': '24.22.0' };\n\nfunction pyBranchVer(sw) {\n  const m = sw.SoftwareName.match(/python\\s+(3\\.\\d+\\.\\d+)/i);\n  if (m) return m[1];\n  // Python Launcher etc: CurrentVersion like 3.13.12150.0 -> 3.13.12\n  const v = String(sw.CurrentVersion || '').match(/^(3)\\.(\\d+)\\.(\\d+)/);\n  if (v) return v[1] + '.' + v[2] + '.' + Math.floor(parseInt(v[3], 10) / 1000);\n  return null;\n}\n\nconst VERSION_DB = [\n  {\n    id: 'java8',\n    displayName: 'Java 8 (Oracle JRE)',\n    match: sw => /java\\s*8\\s*(update|u)\\s*\\d+/i.test(sw.SoftwareName),\n    instVer: sw => { const m = sw.SoftwareName.match(/update\\s*(\\d+)/i); return m ? '8.' + m[1] : null; },\n    instDisplay: sw => { const m = sw.SoftwareName.match(/update\\s*(\\d+)/i); return m ? '8u' + m[1] : sw.CurrentVersion; },\n    latestVer: () => '8.503',\n    latestDisplay: () => '8u503',\n    refLatest: '8u503',\n    severity: 'critical',\n    category: 'Runtime',\n    releaseDate: '2026-07',\n    notes: 'Oracle CPU security fixes. Next CPU scheduled 2026-10-20 (reference will need updating).'\n  },\n  {\n    id: 'java_auto_updater',\n    displayName: 'Java Auto Updater',\n    match: sw => /java\\s*auto\\s*updater/i.test(sw.SoftwareName),\n    // CurrentVersion like 2.8.471.9 -> third segment is the JRE update number\n    instVer: sw => { const p = String(sw.CurrentVersion || '').split('.'); return p.length >= 3 ? '8.' + p[2] : null; },\n    instDisplay: sw => { const p = String(sw.CurrentVersion || '').split('.'); return sw.CurrentVersion + (p.length >= 3 ? ' (8u' + p[2] + ')' : ''); },\n    latestVer: () => '8.503',\n    latestDisplay: () => 'Ships with 8u503',\n    refLatest: 'Follows JRE',\n    severity: 'low',\n    category: 'Utility',\n    releaseDate: null,\n    notes: 'Updated together with the Java 8 JRE.'\n  },\n  {\n    id: '7zip',\n    displayName: '7-Zip',\n    match: sw => /^7-zip/i.test(sw.SoftwareName),\n    instVer: sw => sw.CurrentVersion,\n    instDisplay: sw => sw.CurrentVersion,\n    latestVer: () => '26.04',\n    latestDisplay: () => '26.04',\n    refLatest: '26.04',\n    severity: 'medium',\n    category: 'Utility',\n    releaseDate: '2026-10-05',\n    notes: '26.04 fixes bugs and vulnerabilities; 26.03 fixed CVE-2026-58052 (Mark-of-the-Web).'\n  },\n  {\n    id: 'chrome',\n    displayName: 'Google Chrome',\n    match: sw => /^google\\s*chrome$/i.test(sw.SoftwareName.trim()),\n    instVer: sw => sw.CurrentVersion,\n    instDisplay: sw => sw.CurrentVersion,\n    latestVer: () => '155.0.8059.79',\n    refMax: '155.0.8059.80', // Windows ships .79 and .80; both are current\n    latestDisplay: () => '155.0.8059.79/.80',\n    refLatest: '155.0.8059.79/.80',\n    // 2+ major versions behind = High; patch-level lag = Medium (auto-update rollout)\n    severity: (inst, lat) => ((parseInt(lat, 10) - parseInt(inst, 10)) >= 2 ? 'high' : 'medium'),\n    category: 'Browser',\n    releaseDate: '2026-10-13',\n    notes: 'Stable update 2026-10-13 with 37 security fixes (7 Critical). Patch lag usually self-heals via auto-update.'\n  },\n  {\n    id: 'adobe_acrobat',\n    displayName: 'Adobe Acrobat (Continuous)',\n    match: sw => /adobe\\s*acrobat/i.test(sw.SoftwareName) && !/reader|refresh/i.test(sw.SoftwareName),\n    instVer: sw => sw.CurrentVersion,\n    instDisplay: sw => sw.CurrentVersion,\n    latestVer: () => '26.002.22031',\n    latestDisplay: () => '26.002.22031',\n    refLatest: '26.002.22031',\n    severity: 'medium',\n    category: 'Productivity',\n    releaseDate: '2026-10-14',\n    notes: 'Continuous track planned update (stability fixes). Auto-updates if enabled.'\n  },\n  {\n    id: 'adobe_refresh',\n    displayName: 'Adobe Refresh Manager',\n    match: sw => /adobe\\s*refresh\\s*manager/i.test(sw.SoftwareName),\n    instVer: sw => sw.CurrentVersion,\n    instDisplay: sw => sw.CurrentVersion,\n    latestVer: () => null,\n    latestDisplay: () => 'N/A',\n    refLatest: null,\n    severity: 'info',\n    category: 'Utility',\n    releaseDate: null,\n    notes: 'Background updater component, not independently versioned.'\n  },\n  {\n    id: 'python3',\n    displayName: 'Python 3',\n    collapse: true,\n    collapseLabel: v => 'Python ' + v,\n    match: sw => /^python\\s+3\\.\\d+\\.\\d+/i.test(sw.SoftwareName) || /^python\\s+launcher$/i.test(sw.SoftwareName.trim()),\n    instVer: sw => pyBranchVer(sw),\n    instDisplay: sw => pyBranchVer(sw) || sw.CurrentVersion,\n    latestVer: sw => { const v = pyBranchVer(sw); return v ? (PY_LATEST[v.split('.').slice(0, 2).join('.')] || null) : null; },\n    latestDisplay: sw => { const v = pyBranchVer(sw); const b = v ? v.split('.').slice(0, 2).join('.') : null; return (b && PY_LATEST[b]) ? PY_LATEST[b] : 'Branch not tracked'; },\n    refLatest: '3.13.16 / 3.14.8',\n    severity: 'medium',\n    category: 'Runtime',\n    releaseDate: '2026-09-30',\n    notes: '3.13.16 includes multiple CVE fixes (ssl, tarfile, zipfile) and is the last full 3.13 maintenance release.'\n  },\n  {\n    id: 'nodejs',\n    displayName: 'Node.js',\n    match: sw => /^node\\.js$/i.test(sw.SoftwareName.trim()),\n    instVer: sw => sw.CurrentVersion,\n    instDisplay: sw => sw.CurrentVersion,\n    latestVer: sw => NODE_LATEST[String(sw.CurrentVersion || '').split('.')[0]] || null,\n    latestDisplay: sw => NODE_LATEST[String(sw.CurrentVersion || '').split('.')[0]] || 'Branch not tracked',\n    refLatest: '24.22.0 (LTS) / 26.12.0',\n    severity: 'medium',\n    category: 'Runtime',\n    releaseDate: '2026-10-14',\n    notes: 'Node 24 LTS enters maintenance 2026-10-20; security releases for 24.x announced for 2026-10-21.'\n  }\n];\n\n/* ============================================================\n   EXCLUDED SOFTWARE (noise reduction)\n   ============================================================ */\nconst EXCLUDE_PATTERNS = [\n  /^update\\s+for/i,\n  /^security\\s+update/i,\n  /^hotfix/i,\n  /^kb\\d+/i,\n  /definition\\s+update/i,\n  /cumulative\\s+update/i,\n  /\\.net\\s+framework.*language/i,\n];\n\nfunction isExcluded(name) {\n  return EXCLUDE_PATTERNS.some(p => p.test(name));\n}\n\n/* ============================================================\n   HELPERS\n   ============================================================ */\nfunction toggleSection(bodyId, headerEl) {\n  const body = document.getElementById(bodyId);\n  const arrow = headerEl.querySelector('.toggle-arrow');\n  body.classList.toggle('collapsed');\n  arrow.classList.toggle('collapsed');\n}\n\nfunction severityOrder(s) {\n  return { critical: 0, high: 1, medium: 2, low: 3, info: 4, current: 5, unknown: 6 }[s] ?? 7;\n}\n\nfunction severityLabel(s) {\n  return { critical: 'Critical', high: 'High', medium: 'Medium', low: 'Low', info: 'Info', current: 'Current', unknown: 'Untracked' }[s] ?? s;\n}\n\nfunction severityClass(s) {\n  return 'risk-' + (s || 'unknown');\n}\n\n// Log Analytics tool returns \"MM/DD/YYYY HH:mm:ss +00:00\"\nfunction parseTs(ts) {\n  if (!ts) return null;\n  const m = String(ts).match(/^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4}) (\\d{1,2}):(\\d{2}):(\\d{2})/);\n  if (m) return new Date(Date.UTC(+m[3], +m[1] - 1, +m[2], +m[4], +m[5], +m[6]));\n  const d = new Date(ts);\n  return isNaN(d.getTime()) ? null : d;\n}\n\nfunction formatTs(ts) {\n  const d = ts instanceof Date ? ts : parseTs(ts);\n  if (!d) return String(ts || '');\n  return d.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';\n}\n\n// Numeric segment-by-segment version compare: -1, 0, 1\nfunction cmpVer(a, b) {\n  const pa = String(a).split(/[.\\-]/).map(x => parseInt(x, 10) || 0);\n  const pb = String(b).split(/[.\\-]/).map(x => parseInt(x, 10) || 0);\n  const n = Math.max(pa.length, pb.length);\n  for (let i = 0; i < n; i++) {\n    const x = pa[i] || 0, y = pb[i] || 0;\n    if (x < y) return -1;\n    if (x > y) return 1;\n  }\n  return 0;\n}\n\nfunction addBanner(text, cls) {\n  const b = document.createElement('div');\n  b.className = 'banner' + (cls ? ' ' + cls : '');\n  b.textContent = text;\n  document.getElementById('banners').appendChild(b);\n}\n\n/* ============================================================\n   TOOL RESULT NORMALISATION\n   The viewer bridge may return the tool output as: an object, a JSON string,\n   a double-encoded JSON string, an MCP envelope ({content:[{text}]}), or a\n   tables format ({columns, rows}). Find the row array wherever it is.\n   ============================================================ */\nfunction unwrapJson(v, depth) {\n  depth = depth || 0;\n  while (typeof v === 'string' && depth < 6) {\n    const s = v.trim();\n    if (!(s.startsWith('{') || s.startsWith('[') || s.startsWith('\"'))) break;\n    try { v = JSON.parse(s); } catch (e) { break; }\n    depth++;\n  }\n  return v;\n}\n\nfunction isRowObj(o) {\n  return o && typeof o === 'object' && !Array.isArray(o) && ('SoftwareName' in o || 'Computer' in o);\n}\n\n// Returns {rows: [...]} on success, {error: msg} for an explicit tool error, or null if not found\nfunction findRows(v, depth) {\n  depth = depth || 0;\n  v = unwrapJson(v);\n  if (v == null || depth > 8) return null;\n  if (Array.isArray(v)) {\n    if (v.length && isRowObj(v[0])) return { rows: v };\n    for (const x of v) { const r = findRows(x, depth + 1); if (r) return r; }\n    return null;\n  }\n  if (typeof v === 'object') {\n    if (Array.isArray(v.columns) && Array.isArray(v.rows)) {\n      const cols = v.columns.map(c => (c && (c.name || c.ColumnName)) || String(c));\n      return { rows: v.rows.map(r => Array.isArray(r) ? Object.fromEntries(cols.map((c, i) => [c, r[i]])) : r) };\n    }\n    const st = v.status !== undefined ? String(v.status) : null;\n    if (Array.isArray(v.results) && v.results.length === 0 && (st === null || st === '200')) return { rows: [] };\n    const keys = ['results', 'result', 'structuredContent', 'content', 'text', 'data', 'tables', 'value', 'rows'];\n    for (const k of keys) {\n      if (k in v) { const r = findRows(v[k], depth + 1); if (r) return r; }\n    }\n    for (const k of Object.keys(v)) {\n      if (keys.includes(k)) continue;\n      const r = findRows(v[k], depth + 1); if (r) return r;\n    }\n    if (st && st !== '200') return { error: (v.message || 'status ' + st) };\n    if (v.isError || v.error) return { error: String(v.message || v.error || 'tool error') };\n  }\n  return null;\n}\n\nfunction describeShape(raw) {\n  try {\n    const s = typeof raw === 'string' ? raw : JSON.stringify(raw);\n    return (typeof raw) + ': ' + String(s).slice(0, 160);\n  } catch (e) { return typeof raw; }\n}\n\n/* ============================================================\n   EMBEDDED SNAPSHOT (fallback when the live query cannot be read)\n   Optional. Leave SNAPSHOT empty in source control (it would contain environment\n   inventory). A deploying team may ask its SRE Agent to fill it with a capture of\n   queries/report-inventory.kql at deploy time.\n   Row format: [SoftwareName, CurrentVersion, Publisher, [computers...]]\n   SNAP_T maps computer -> 'MM/DD/YYYY HH:mm:ss +00:00' (last inventory time)\n   ============================================================ */\nconst SNAPSHOT_TAKEN = '';\nconst SNAP_T = {};\nconst SNAPSHOT = [];\n\nfunction snapshotRows() {\n  const out = [];\n  SNAPSHOT.forEach(([n, v, p, ms]) => ms.forEach(m => out.push({\n    Computer: m, SoftwareName: n, CurrentVersion: v, Publisher: p, SoftwareType: 'Application',\n    TimeGenerated: SNAP_T[m], LastInventory: SNAP_T[m]\n  })));\n  return out;\n}\n\nfunction setText(id, text) {\n  const el = document.getElementById(id);\n  if (el) el.textContent = text;\n}\n\n/* ============================================================\n   MAIN\n   ============================================================ */\n(async function main() {\n  if (document.querySelectorAll) {\n    document.querySelectorAll('.section-header[data-target]').forEach(h => {\n      h.addEventListener('click', () => toggleSection(h.getAttribute('data-target'), h));\n    });\n  }\n  const loadingEl = document.getElementById('loading');\n  const now = new Date().toISOString().replace('T', ' ').slice(0, 16) + ' UTC';\n  setText('refreshTs', 'Refreshed: ' + now);\n  setText('vdbTs', 'Version DB: ' + VERSION_DB_DATE);\n\n  // Render version database reference\n  renderVDB();\n\n  const dbAgeDays = Math.floor((Date.now() - Date.parse(VERSION_DB_DATE + 'T00:00:00Z')) / 86400000);\n  if (dbAgeDays > VERSION_DB_MAX_AGE_DAYS) {\n    addBanner('Version reference database is ' + dbAgeDays + ' days old (last updated ' + VERSION_DB_DATE +\n      '). \"Latest\" versions may be outdated; ask the SRE Agent to refresh the reference versions.');\n  }\n\n  const QUERY_LIMIT = CONFIG.queryLimit;\n  let allSoftware = [];\n  try {\n    if (Object.values(CONFIG).some(v => /^<.*>$/.test(String(v)))) {\n      throw new Error('CONFIG still contains placeholder values; edit the CONFIG block before deploying');\n    }\n    const raw = await window.sreagent.callTool(\n      LOG_QUERY_TOOL,\n      {\n        'resource-group': CONFIG.resourceGroup,\n        workspace: CONFIG.workspaceId,\n        subscription: CONFIG.subscription,\n        table: 'ConfigurationData',\n        // Windows applications only (Linux dpkg/rpm packages are SoftwareType=Package and\n        // previously flooded the row limit). Keep only rows from each machine's latest\n        // inventory snapshot so uninstalled/upgraded software does not linger.\n        query: [\n          'let sw = ConfigurationData',\n          '| where TimeGenerated > ago(7d)',\n          '| where ConfigDataType == \"Software\"',\n          '| where SoftwareType == \"Application\"',\n          '| where isnotempty(Publisher) and Publisher !has \"Microsoft\"',\n          '| where SoftwareName !has \"Update for\" and SoftwareName !has \"Security Update\" and SoftwareName !has \"Hotfix for\" and SoftwareName !has \"Definition Update\";',\n          'let lastInv = sw | summarize LastInventory = max(TimeGenerated) by Computer;',\n          'sw',\n          '| summarize arg_max(TimeGenerated, *) by Computer, SoftwareName',\n          '| join kind=inner lastInv on Computer',\n          '| where TimeGenerated >= LastInventory - 26h',\n          '| project Computer, SoftwareName, CurrentVersion, Publisher, SoftwareType, TimeGenerated, LastInventory',\n          '| sort by SoftwareName asc, Computer asc'\n        ].join(' '),\n        hours: CONFIG.lookbackHours,\n        limit: QUERY_LIMIT\n      }\n    );\n\n    const found = findRows(raw);\n    if (!found) throw new Error('Unrecognised tool response (' + describeShape(raw) + ')');\n    if (found.error) throw new Error('Query error: ' + found.error);\n    if (found.rows.length >= QUERY_LIMIT) {\n      addBanner('Result hit the ' + QUERY_LIMIT + '-row limit; some software may be missing from this view.');\n    }\n    if (found.rows.length === 0) throw new Error('Live query returned 0 rows');\n    allSoftware = found.rows.filter(r => r && r.SoftwareName && !isExcluded(r.SoftwareName));\n    setText('dataSource', 'Data: LIVE');\n  } catch (err) {\n    const reason = String((err && err.message) || err).slice(0, 220);\n    if (!SNAPSHOT.length) {\n      loadingEl.style.display = 'none';\n      setText('dataSource', 'Data: UNAVAILABLE');\n      const pc = document.getElementById('priorityContent');\n      pc.innerHTML = '';\n      const box = document.createElement('div');\n      box.className = 'error-box';\n      box.textContent = 'Failed to load software inventory: ' + reason;\n      pc.appendChild(box);\n      return;\n    }\n    // Fall back to the embedded snapshot so the report always renders\n    allSoftware = snapshotRows().filter(r => !isExcluded(r.SoftwareName));\n    setText('dataSource', 'Data: SNAPSHOT ' + SNAPSHOT_TAKEN);\n    addBanner('Live inventory query could not be loaded (' + String((err && err.message) || err).slice(0, 220) +\n      '). Showing the embedded snapshot captured ' + SNAPSHOT_TAKEN + '. Reload to retry.');\n  }\n\n  // Coverage / freshness\n  const lastByMachine = {};\n  allSoftware.forEach(r => {\n    const d = parseTs(r.LastInventory || r.TimeGenerated);\n    if (d && (!lastByMachine[r.Computer] || d > lastByMachine[r.Computer])) lastByMachine[r.Computer] = d;\n  });\n  const machineTimes = Object.values(lastByMachine);\n  if (machineTimes.length) {\n    const newest = new Date(Math.max(...machineTimes));\n    const oldest = new Date(Math.min(...machineTimes));\n    setText('coverageTs', 'Inventory: ' + machineTimes.length + ' machines with 3rd-party apps, latest ' + formatTs(newest));\n    const staleHrs = (Date.now() - oldest.getTime()) / 3600000;\n    if (staleHrs > 48) {\n      const stale = Object.entries(lastByMachine).filter(([, d]) => (Date.now() - d.getTime()) > 48 * 3600000).map(([m]) => m);\n      addBanner('Inventory older than 48h for: ' + stale.join(', ') + '. Change Tracking data for these machines may be delayed.', 'info');\n    }\n  } else {\n    addBanner('No Change Tracking software inventory returned for the last 7 days. Check the Change Tracking DCR and AMA on the machines.');\n  }\n\n  // Classify each software entry (numeric compare: installed >= latest => Current)\n  const rawClassified = allSoftware.map(sw => {\n    const db = VERSION_DB.find(d => d.match(sw));\n    if (db) {\n      const inst = db.instVer(sw);\n      const lat = db.latestVer(sw);\n      let outdated = false, newerThanRef = false, severity;\n      if (inst && lat) {\n        const c = cmpVer(inst, lat);\n        outdated = c < 0;\n        newerThanRef = cmpVer(inst, db.refMax || lat) > 0;\n        severity = outdated ? (typeof db.severity === 'function' ? db.severity(inst, lat) : db.severity) : 'current';\n      } else {\n        severity = db.severity === 'info' ? 'info' : 'unknown';\n      }\n      return {\n        ...sw,\n        tracked: !!lat || db.severity === 'info',\n        productId: db.id,\n        productName: db.displayName,\n        collapse: !!db.collapse,\n        collapseLabel: db.collapseLabel || null,\n        installedDisplay: db.instDisplay(sw),\n        latestDisplay: db.latestDisplay(sw),\n        outdated,\n        newerThanRef,\n        severity,\n        category: db.category,\n        notes: db.notes,\n        releaseDate: db.releaseDate\n      };\n    }\n    return {\n      ...sw,\n      tracked: false,\n      productId: 'untracked:' + sw.SoftwareName,\n      productName: sw.SoftwareName,\n      installedDisplay: sw.CurrentVersion,\n      latestDisplay: 'N/A',\n      outdated: false,\n      newerThanRef: false,\n      severity: 'unknown',\n      category: 'Untracked',\n      notes: 'Not in version reference database',\n      releaseDate: null\n    };\n  });\n\n  // Collapse multi-component installs (e.g. Python installs ~10 MSI components) to one row per machine\n  const collapsed = new Map();\n  const classified = [];\n  rawClassified.forEach(e => {\n    if (!e.collapse) { classified.push(e); return; }\n    const key = e.productId + '|' + e.Computer + '|' + e.installedDisplay;\n    if (!collapsed.has(key)) {\n      const row = { ...e, components: 1 };\n      collapsed.set(key, row);\n      classified.push(row);\n    } else {\n      const row = collapsed.get(key);\n      row.components += 1;\n      const a = parseTs(row.TimeGenerated), b = parseTs(e.TimeGenerated);\n      if (a && b && b > a) row.TimeGenerated = e.TimeGenerated;\n    }\n  });\n  classified.forEach(e => {\n    if (e.collapse) e.SoftwareName = (e.collapseLabel ? e.collapseLabel(e.installedDisplay) : e.productName + ' ' + e.installedDisplay) + (e.components > 1 ? ' (' + e.components + ' components)' : '');\n  });\n\n  // Self-check: installed versions newer than reference => reference DB is stale\n  const newer = new Map();\n  classified.filter(c => c.newerThanRef).forEach(c => {\n    const k = c.productName + ' ' + c.installedDisplay;\n    if (!newer.has(k)) newer.set(k, { latest: c.latestDisplay, machines: new Set() });\n    newer.get(k).machines.add(c.Computer);\n  });\n  newer.forEach((v, k) => {\n    addBanner('Reference may be stale: ' + k + ' is installed on ' + v.machines.size +\n      ' machine(s) but the reference \"latest\" is ' + v.latest + '. Those machines are shown as Current.');\n  });\n\n  // Compute stats\n  const trackedEntries = classified.filter(c => c.tracked);\n  const outdatedEntries = classified.filter(c => c.outdated);\n  const currentEntries = classified.filter(c => c.severity === 'current');\n  const untrackedEntries = classified.filter(c => c.severity === 'unknown');\n  const criticalEntries = outdatedEntries.filter(c => c.severity === 'critical' || c.severity === 'high');\n  setText('untrackedCount', String(untrackedEntries.length));\n\n  // Unique outdated products (by productId + Computer)\n  const uniqueOutdated = new Map();\n  outdatedEntries.forEach(e => {\n    const key = e.productId + '|' + e.Computer;\n    if (!uniqueOutdated.has(key)) uniqueOutdated.set(key, e);\n  });\n\n  setText('totalCount', String(classified.length));\n  setText('currentCount', String(currentEntries.length));\n  setText('outdatedCount', String(outdatedEntries.length));\n  setText('criticalCount', String(criticalEntries.length));\n  setText('priorityBadge', outdatedEntries.length + ' items');\n  setText('inventoryBadge', classified.length + ' entries');\n\n  // Render priority table\n  renderPriorityTable(outdatedEntries);\n\n  // Render full inventory grid\n  renderInventoryGrid(classified);\n\n  // Render machine chart\n  renderMachineChart(outdatedEntries);\n\n  // Done\n  loadingEl.style.display = 'none';\n})();\n\n/* ============================================================\n   RENDER: Priority Table\n   ============================================================ */\nfunction renderPriorityTable(outdated) {\n  const container = document.getElementById('priorityContent');\n  container.innerHTML = '';\n\n  if (outdated.length === 0) {\n    const empty = document.createElement('div');\n    empty.className = 'empty-state';\n    empty.textContent = 'All tracked software is up to date.';\n    container.appendChild(empty);\n    return;\n  }\n\n  // Group by product, sort by severity\n  const grouped = new Map();\n  outdated.forEach(e => {\n    const gk = e.productId + '|' + e.latestDisplay + '|' + e.severity;\n    if (!grouped.has(gk)) {\n      grouped.set(gk, {\n        ...e,\n        machines: [e.Computer],\n        allEntries: [e]\n      });\n    } else {\n      const g = grouped.get(gk);\n      if (!g.machines.includes(e.Computer)) g.machines.push(e.Computer);\n      g.allEntries.push(e);\n    }\n  });\n\n  const sorted = [...grouped.values()].sort((a, b) => severityOrder(a.severity) - severityOrder(b.severity));\n\n  const table = document.createElement('table');\n  table.className = 'priority-table';\n\n  const thead = document.createElement('thead');\n  const headerRow = document.createElement('tr');\n  ['Risk', 'Product', 'Installed', 'Latest Available', 'Affected Machines', 'Notes'].forEach(h => {\n    const th = document.createElement('th');\n    th.textContent = h;\n    headerRow.appendChild(th);\n  });\n  thead.appendChild(headerRow);\n  table.appendChild(thead);\n\n  const tbody = document.createElement('tbody');\n  sorted.forEach(item => {\n    const tr = document.createElement('tr');\n\n    // Risk\n    const tdRisk = document.createElement('td');\n    const badge = document.createElement('span');\n    badge.className = 'risk-badge ' + severityClass(item.severity);\n    badge.textContent = severityLabel(item.severity);\n    tdRisk.appendChild(badge);\n    tr.appendChild(tdRisk);\n\n    // Product\n    const tdProd = document.createElement('td');\n    tdProd.style.fontWeight = '600';\n    tdProd.textContent = item.productName;\n    tr.appendChild(tdProd);\n\n    // Installed\n    const tdInst = document.createElement('td');\n    const versions = [...new Set(item.allEntries.map(e => e.installedDisplay))];\n    tdInst.textContent = versions.join(', ');\n    tdInst.style.fontFamily = \"'Inter', monospace\";\n    tdInst.style.color = '#dc2626';\n    tr.appendChild(tdInst);\n\n    // Latest\n    const tdLat = document.createElement('td');\n    tdLat.textContent = item.latestDisplay;\n    tdLat.style.fontFamily = \"'Inter', monospace\";\n    tdLat.style.color = '#10b981';\n    tdLat.style.fontWeight = '600';\n    tr.appendChild(tdLat);\n\n    // Machines\n    const tdMach = document.createElement('td');\n    const machDiv = document.createElement('div');\n    machDiv.className = 'machine-list';\n    item.machines.sort().forEach(m => {\n      const tag = document.createElement('span');\n      tag.className = 'machine-tag';\n      tag.textContent = m;\n      machDiv.appendChild(tag);\n    });\n    tdMach.appendChild(machDiv);\n    tr.appendChild(tdMach);\n\n    // Notes\n    const tdNotes = document.createElement('td');\n    tdNotes.textContent = item.notes;\n    tdNotes.style.fontSize = '12px';\n    tdNotes.style.color = '#64748b';\n    tdNotes.style.maxWidth = '240px';\n    tr.appendChild(tdNotes);\n\n    tbody.appendChild(tr);\n  });\n  table.appendChild(tbody);\n  container.appendChild(table);\n}\n\n/* ============================================================\n   RENDER: Inventory Grid (Grid.js)\n   ============================================================ */\nfunction renderInventoryGrid(classified) {\n  const container = document.getElementById('inventoryGrid');\n  container.innerHTML = '';\n\n  if (classified.length === 0) {\n    const empty = document.createElement('div');\n    empty.className = 'empty-state';\n    empty.textContent = 'No software inventory data found.';\n    container.appendChild(empty);\n    return;\n  }\n\n  const sorted = [...classified].sort((a, b) => {\n    const so = severityOrder(a.severity) - severityOrder(b.severity);\n    if (so !== 0) return so;\n    return a.SoftwareName.localeCompare(b.SoftwareName);\n  });\n\n  new gridjs.Grid({\n    columns: [\n      { name: 'Status', width: '90px',\n        formatter: (cell) => gridjs.html(\n          '<span class=\"risk-badge ' + severityClass(cell) + '\">' +\n          severityLabel(cell).replace(/</g,'&lt;') + '</span>'\n        )\n      },\n      { name: 'Computer', width: '140px' },\n      { name: 'Software', width: '220px' },\n      { name: 'Installed', width: '130px' },\n      { name: 'Latest', width: '130px' },\n      { name: 'Publisher', width: '140px' },\n      { name: 'Last Seen', width: '150px' }\n    ],\n    data: sorted.map(r => [\n      r.severity,\n      r.Computer,\n      r.SoftwareName,\n      r.installedDisplay,\n      r.latestDisplay,\n      r.Publisher,\n      formatTs(r.TimeGenerated)\n    ]),\n    search: true,\n    sort: true,\n    pagination: { limit: 25 },\n    style: {\n      table: { 'font-size': '13px' },\n      th: { 'font-size': '11px', 'text-transform': 'uppercase' }\n    },\n    language: {\n      search: { placeholder: 'Search software, machine, publisher...' },\n      pagination: {\n        showing: 'Showing',\n        results: () => 'entries'\n      }\n    }\n  }).render(container);\n}\n\n/* ============================================================\n   RENDER: Machine Bar Chart\n   ============================================================ */\nfunction renderMachineChart(outdated) {\n  const canvas = document.getElementById('machineChart');\n  if (!canvas) return;\n\n  if (outdated.length === 0) {\n    const parent = canvas.parentElement;\n    parent.innerHTML = '';\n    const empty = document.createElement('div');\n    empty.className = 'empty-state';\n    empty.textContent = 'No outdated software detected.';\n    parent.appendChild(empty);\n    return;\n  }\n\n  // Count outdated items per machine\n  const counts = {};\n  outdated.forEach(e => {\n    counts[e.Computer] = (counts[e.Computer] || 0) + 1;\n  });\n\n  const entries = Object.entries(counts).sort((a, b) => b[1] - a[1]);\n  const labels = entries.map(e => e[0]);\n  const values = entries.map(e => e[1]);\n\n  // Color by count\n  const colors = values.map(v => {\n    if (v >= 3) return '#dc2626';\n    if (v >= 2) return '#f59e0b';\n    return '#3b82f6';\n  });\n\n  Chart.register(ChartDataLabels);\n  new Chart(canvas.getContext('2d'), {\n    type: 'bar',\n    data: {\n      labels,\n      datasets: [{\n        label: 'Outdated Products',\n        data: values,\n        backgroundColor: colors,\n        borderRadius: 4,\n        barThickness: 24\n      }]\n    },\n    options: {\n      indexAxis: 'y',\n      responsive: true,\n      maintainAspectRatio: false,\n      plugins: {\n        legend: { display: false },\n        datalabels: {\n          anchor: 'end',\n          align: 'end',\n          color: '#475569',\n          font: { size: 12, weight: '600', family: 'Inter' },\n          formatter: v => v\n        },\n        tooltip: {\n          callbacks: {\n            label: ctx => ctx.parsed.x + ' outdated product(s)'\n          }\n        }\n      },\n      scales: {\n        x: {\n          beginAtZero: true,\n          ticks: {\n            stepSize: 1,\n            font: { size: 11, family: 'Inter' },\n            color: '#94a3b8'\n          },\n          grid: { color: '#f1f5f9' },\n          title: {\n            display: true,\n            text: 'Number of Outdated Products',\n            font: { size: 11, family: 'Inter', weight: '600' },\n            color: '#64748b'\n          }\n        },\n        y: {\n          ticks: {\n            font: { size: 12, family: 'Inter', weight: '500' },\n            color: '#1e293b'\n          },\n          grid: { display: false }\n        }\n      }\n    }\n  });\n\n  // Resize canvas height based on number of machines\n  canvas.parentElement.style.height = Math.max(200, entries.length * 40 + 80) + 'px';\n}\n\n/* ============================================================\n   RENDER: Version Database Reference\n   ============================================================ */\nfunction renderVDB() {\n  const container = document.getElementById('vdbContent');\n  const info = document.createElement('div');\n  info.className = 'vdb-info';\n\n  const header = document.createElement('div');\n  header.innerHTML = '';\n  const headerStrong = document.createElement('strong');\n  headerStrong.textContent = 'Version Reference Database';\n  header.appendChild(headerStrong);\n  const headerText = document.createTextNode(\n    ' \\u2014 Last updated: ' + VERSION_DB_DATE +\n    '. These are the latest known versions used to determine update status. ' +\n    'Products not in this database are shown as \"Untracked\".'\n  );\n  header.appendChild(headerText);\n  info.appendChild(header);\n\n  const grid = document.createElement('div');\n  grid.className = 'vdb-grid';\n\n  VERSION_DB.filter(db => db.refLatest).forEach(db => {\n    const item = document.createElement('div');\n    item.className = 'vdb-item';\n\n    const prod = document.createElement('div');\n    prod.className = 'prod';\n    prod.textContent = db.displayName;\n    item.appendChild(prod);\n\n    const ver = document.createElement('div');\n    const verLabel = document.createTextNode('Latest: ');\n    const verSpan = document.createElement('span');\n    verSpan.className = 'ver';\n    verSpan.textContent = db.refLatest;\n    ver.appendChild(verLabel);\n    ver.appendChild(verSpan);\n    if (db.releaseDate) {\n      const dateSpan = document.createElement('span');\n      dateSpan.className = 'date';\n      dateSpan.textContent = ' (released ' + db.releaseDate + ')';\n      ver.appendChild(dateSpan);\n    }\n    item.appendChild(ver);\n\n    const cat = document.createElement('div');\n    cat.style.cssText = 'font-size:11px;color:#94a3b8;margin-top:2px;';\n    cat.textContent = db.category + ' \\u2022 ' + (db.severity === 'critical' ? 'Security-critical updates' : (db.severity === 'medium' || typeof db.severity === 'function') ? 'Security updates' : 'Standard updates');\n    item.appendChild(cat);\n\n    grid.appendChild(item);\n  });\n\n  info.appendChild(grid);\n  container.appendChild(info);\n}\n</script>\n</body>\n</html>\n",
