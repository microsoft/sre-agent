{
  "schemaVersion": "sreagent.livereport/v1",
  "kind": "LiveReport",
  "metadata": {
    "name": "Third-Party Software Update Tracker",
    "description": "Third-party Windows application versions from Change Tracking (ConfigurationData, latest inventory per machine) compared numerically against an embedded vendor reference DB (2026-10-15). No embedded data; recommended for new environments.",
