topology            = "cross-region"
resource_group_name = "rg-private-splunk-cross-region"
name_prefix         = "sre-splunk"
agent_location      = "eastus2"
splunk_location     = "centralus"

agent_vnet_address_prefix  = "10.20.0.0/16"
splunk_vnet_address_prefix = "10.40.0.0/16"
agent_subnet_prefix        = "10.20.0.0/27"
splunk_subnet_prefix       = "10.40.1.0/24"
splunk_private_ip          = "10.40.1.4"

vm_size             = "Standard_D4as_v5"
admin_username       = "azureuser"
admin_ssh_public_key = "ssh-ed25519 REPLACE_WITH_YOUR_PUBLIC_KEY"

tags = {
  environment = "lab"
  workload    = "private-splunk-mcp"
}
